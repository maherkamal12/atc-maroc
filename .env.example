# ---------------------------------------------------------------------------
# Postgres connection string (Neon, Supabase, Vercel Postgres, ...).
# Required for /admin, contact messages and quote requests (orders).
# Without it the site still builds and serves the bundled catalog read-only.
#
# Neon: https://console.neon.tech -> your project -> "Connect" -> copy the
# connection string. Keep `?sslmode=require` at the end.
#
#   DATABASE_URL="postgresql://user:password@ep-cool-name-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
#
# The tables are created automatically the first time the app talks to the
# database (see src/db/migrate.ts). Set DATABASE_AUTO_MIGRATE=false to disable
# that and create them explicitly with `npm run db:push` instead.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Optional: disable the automatic creation of missing tables.
# DATABASE_AUTO_MIGRATE="false"

# Optional: canonical origin used by sitemap.xml / robots.txt.
NEXT_PUBLIC_SITE_URL="https://atc-maroc.com"

# Optional: password for the /admin area (defaults to "atc2026").
ADMIN_PASSWORD="change-me"

# Optional: extra origins allowed to submit Server Actions / log in, comma
# separated (preview deployments, tunnels, custom reverse proxies).
# SERVER_ACTIONS_ALLOWED_ORIGINS="my-preview.example.com,*.my-proxy.dev"

# Optional: Vercel Blob token for /admin/media uploads.
# BLOB_READ_WRITE_TOKEN=""
